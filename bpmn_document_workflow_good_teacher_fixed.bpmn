      <bpmn:incoming>Flow_Database_HR_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ArchiveDocument" name="Архивирование документа">
      <bpmn:incoming>Flow_Database_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_Database" name="Завершение обработки документа">
