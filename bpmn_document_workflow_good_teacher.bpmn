<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Menager" name="Менеджер по продажам" processRef="Process_Menager" />
    <bpmn:participant id="Participant_Legal" name="Юридический отдел" processRef="Process_Legal" />
    <bpmn:participant id="Participant_Client" name="Клиент" processRef="Process_Client" />
    <bpmn:participant id="Participant_Accounting" name="Бухгалтерия" processRef="Process_Accounting" />
    <bpmn:participant id="Participant_Education" name="Учебный отдел" processRef="Process_Education" />
    <bpmn:participant id="Participant_HR" name="Кадровый отдел" processRef="Process_HR" />
    <bpmn:participant id="Participant_Management" name="Руководство/Администрация" processRef="Process_Management" />
    <bpmn:participant id="Participant_Database" name="База данных документооборота" processRef="Process_Database" />
    
    <!-- Сообщения между участниками с документами -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_ReceiveRequest" targetRef="Task_ReviewProposal" name="Заявка клиента" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_PrepareCommercialProposal" targetRef="StartEvent_Client" name="Коммерческое предложение" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_ApproveConditions" targetRef="Task_PrepareContract" name="Заявка на договор" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_PrepareContract" targetRef="Task_SignContract" name="Проект договора" />
    <bpmn:messageFlow id="MessageFlow_5" sourceRef="Task_SignContract" targetRef="Task_IssueInvoice" name="Подписанный договор" />
    <bpmn:messageFlow id="MessageFlow_6" sourceRef="Task_MakePayment" targetRef="Task_ProcessPayment" name="Платежное поручение" />
    <bpmn:messageFlow id="MessageFlow_7" sourceRef="Task_ProcessPayment" targetRef="Task_CreateStudyProgram" name="Подтверждение оплаты" />
    <bpmn:messageFlow id="MessageFlow_8" sourceRef="Task_CreateStudyProgram" targetRef="Task_AssignTeachers" name="Запрос на преподавателей" />
    <bpmn:messageFlow id="MessageFlow_9" sourceRef="Task_AssignTeachers" targetRef="Task_ConductTraining" name="Список преподавателей" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="Task_ConductTraining" targetRef="Task_CreateAct" name="Отчет о проведении обучения" />
    <bpmn:messageFlow id="MessageFlow_11" sourceRef="Task_CreateAct" targetRef="StartEvent_Database" name="Акт оказанных услуг" />
    
    <!-- Дополнительные потоки документов в БД -->
    <bpmn:messageFlow id="MessageFlow_DB_1" sourceRef="Task_ReceiveRequest" targetRef="StartEvent_Database" name="Регистрация заявки" />
    <bpmn:messageFlow id="MessageFlow_DB_2" sourceRef="Task_PrepareCommercialProposal" targetRef="StartEvent_Database" name="Сохранение КП" />
    <bpmn:messageFlow id="MessageFlow_DB_3" sourceRef="Task_PrepareContract" targetRef="StartEvent_Database" name="Сохранение договора" />
    <bpmn:messageFlow id="MessageFlow_DB_4" sourceRef="Task_IssueInvoice" targetRef="StartEvent_Database" name="Регистрация счета" />
    <bpmn:messageFlow id="MessageFlow_DB_5" sourceRef="Task_ProcessPayment" targetRef="Task_UpdateStatus" name="Обновление статуса оплаты" />
    <bpmn:messageFlow id="MessageFlow_DB_6" sourceRef="Task_CreateStudyProgram" targetRef="StartEvent_Database" name="Сохранение учебного плана" />
    <bpmn:messageFlow id="MessageFlow_DB_7" sourceRef="Task_AssignTeachers" targetRef="StartEvent_Database" name="Сохранение кадровых документов" />
    <bpmn:messageFlow id="MessageFlow_DB_8" sourceRef="Task_ConductTraining" targetRef="StartEvent_Database" name="Сохранение журналов и протоколов" />
    <bpmn:messageFlow id="MessageFlow_DB_9" sourceRef="Task_CreateAct" targetRef="Task_UpdateStatus" name="Обновление статуса завершения" />
  </bpmn:collaboration>

  <!-- Процесс Менеджера по продажам -->
  <bpmn:process id="Process_Menager" name="Процесс менеджера по продажам" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Получение запроса от клиента">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс обработки заявки -->
    <bpmn:subProcess id="SubProcess_RequestProcessing" name="Обработка заявки клиента">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      
      <bpmn:task id="Task_ReceiveRequest" name="Ввод данных клиента в БД">
        <bpmn:incoming>Flow_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_ValidateClientData" name="Проверка данных клиента">
        <bpmn:incoming>Flow_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:exclusiveGateway id="Gateway_ClientValidation" name="Данные корректны?">
        <bpmn:incoming>Flow_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_4</bpmn:outgoing>
        <bpmn:outgoing>Flow_Sub_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      
      <bpmn:task id="Task_CorrectData" name="Исправление данных">
        <bpmn:incoming>Flow_Sub_5</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_6</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_ApproveData" name="Утверждение данных">
        <bpmn:incoming>Flow_Sub_4</bpmn:incoming>
        <bpmn:incoming>Flow_Sub_6</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_7</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Sub_1" sourceRef="SubProcess_RequestProcessing" targetRef="Task_ReceiveRequest" />
      <bpmn:sequenceFlow id="Flow_Sub_2" sourceRef="Task_ReceiveRequest" targetRef="Task_ValidateClientData" />
      <bpmn:sequenceFlow id="Flow_Sub_3" sourceRef="Task_ValidateClientData" targetRef="Gateway_ClientValidation" />
      <bpmn:sequenceFlow id="Flow_Sub_4" sourceRef="Gateway_ClientValidation" targetRef="Task_ApproveData" name="Да" />
      <bpmn:sequenceFlow id="Flow_Sub_5" sourceRef="Gateway_ClientValidation" targetRef="Task_CorrectData" name="Нет" />
      <bpmn:sequenceFlow id="Flow_Sub_6" sourceRef="Task_CorrectData" targetRef="Task_ApproveData" />
      <bpmn:sequenceFlow id="Flow_Sub_7" sourceRef="Task_ApproveData" targetRef="SubProcess_RequestProcessing" />
    </bpmn:subProcess>
    
    <bpmn:task id="Task_PrepareCommercialProposal" name="Подготовка коммерческого предложения">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - отправка КП -->
    <bpmn:intermediateThrowEvent id="Event_SendProposal" name="Отправка КП клиенту">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:task id="Task_ApproveConditions" name="Согласование условий с клиентом">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Шлюз для проверки согласования -->
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Условия согласованы?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ReviseProposal" name="Пересмотр предложения">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_TransferToLegal" name="Передача заявки в юридический отдел">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - ожидание ответа -->
    <bpmn:intermediateCatchEvent id="Event_WaitLegalResponse" name="Ожидание ответа от юридического отдела">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:endEvent id="EndEvent_Menager" name="Завершение работы менеджера">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_RequestProcessing" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_RequestProcessing" targetRef="Task_PrepareCommercialProposal" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PrepareCommercialProposal" targetRef="Event_SendProposal" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_SendProposal" targetRef="Task_ApproveConditions" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ApproveConditions" targetRef="Gateway_Approval" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Approval" targetRef="Task_TransferToLegal" name="Да" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Approval" targetRef="Task_ReviseProposal" name="Нет" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ReviseProposal" targetRef="Task_TransferToLegal" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_TransferToLegal" targetRef="Event_WaitLegalResponse" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_WaitLegalResponse" targetRef="EndEvent_Menager" />
  </bpmn:process>

  <!-- Процесс Юридического отдела -->
  <bpmn:process id="Process_Legal" name="Процесс юридического отдела" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Legal" name="Получение заявки от менеджера">
      <bpmn:outgoing>Flow_Legal_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс анализа требований -->
    <bpmn:subProcess id="SubProcess_RequirementAnalysis" name="Анализ требований клиента">
      <bpmn:incoming>Flow_Legal_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_2</bpmn:outgoing>
      
      <bpmn:task id="Task_AnalyzeRequirements" name="Анализ требований">
        <bpmn:incoming>Flow_Legal_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Legal_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CheckLegalCompliance" name="Проверка соответствия законодательству">
        <bpmn:incoming>Flow_Legal_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Legal_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Legal_Sub_1" sourceRef="SubProcess_RequirementAnalysis" targetRef="Task_AnalyzeRequirements" />
      <bpmn:sequenceFlow id="Flow_Legal_Sub_2" sourceRef="Task_AnalyzeRequirements" targetRef="Task_CheckLegalCompliance" />
      <bpmn:sequenceFlow id="Flow_Legal_Sub_3" sourceRef="Task_CheckLegalCompliance" targetRef="SubProcess_RequirementAnalysis" />
    </bpmn:subProcess>
    
    <bpmn:task id="Task_PrepareContract" name="Подготовка проекта договора">
      <bpmn:incoming>Flow_Legal_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Параллельный шлюз для согласования -->
    <bpmn:parallelGateway id="Gateway_ParallelApproval" name="Параллельное согласование">
      <bpmn:incoming>Flow_Legal_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Legal_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:task id="Task_LegalReview" name="Юридическая экспертиза">
      <bpmn:incoming>Flow_Legal_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ManagementApproval" name="Согласование с руководством">
      <bpmn:incoming>Flow_Legal_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_7</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Соединительный шлюз -->
    <bpmn:parallelGateway id="Gateway_JoinApproval" name="Ожидание всех согласований">
      <bpmn:incoming>Flow_Legal_6</bpmn:incoming>
      <bpmn:incoming>Flow_Legal_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Шлюз для проверки результата согласования -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalResult" name="Согласование пройдено?">
      <bpmn:incoming>Flow_Legal_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Legal_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ReviseContract" name="Доработка договора">
      <bpmn:incoming>Flow_Legal_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ApproveContract" name="Утверждение договора">
      <bpmn:incoming>Flow_Legal_9</bpmn:incoming>
      <bpmn:incoming>Flow_Legal_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_12</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - отправка договора -->
    <bpmn:intermediateThrowEvent id="Event_SendContract" name="Отправка договора клиенту">
      <bpmn:incoming>Flow_Legal_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_13</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:task id="Task_SendContractToClient" name="Передача договора клиенту">
      <bpmn:incoming>Flow_Legal_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_14</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - ожидание подписи -->
    <bpmn:intermediateCatchEvent id="Event_WaitSignature" name="Ожидание подписи клиента">
      <bpmn:incoming>Flow_Legal_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:endEvent id="EndEvent_Legal" name="Завершение работы юридического отдела">
      <bpmn:incoming>Flow_Legal_15</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_Legal_1" sourceRef="StartEvent_Legal" targetRef="SubProcess_RequirementAnalysis" />
    <bpmn:sequenceFlow id="Flow_Legal_2" sourceRef="SubProcess_RequirementAnalysis" targetRef="Task_PrepareContract" />
    <bpmn:sequenceFlow id="Flow_Legal_3" sourceRef="Task_PrepareContract" targetRef="Gateway_ParallelApproval" />
    <bpmn:sequenceFlow id="Flow_Legal_4" sourceRef="Gateway_ParallelApproval" targetRef="Task_LegalReview" />
    <bpmn:sequenceFlow id="Flow_Legal_5" sourceRef="Gateway_ParallelApproval" targetRef="Task_ManagementApproval" />
    <bpmn:sequenceFlow id="Flow_Legal_6" sourceRef="Task_LegalReview" targetRef="Gateway_JoinApproval" />
    <bpmn:sequenceFlow id="Flow_Legal_7" sourceRef="Task_ManagementApproval" targetRef="Gateway_JoinApproval" />
    <bpmn:sequenceFlow id="Flow_Legal_8" sourceRef="Gateway_JoinApproval" targetRef="Gateway_ApprovalResult" />
    <bpmn:sequenceFlow id="Flow_Legal_9" sourceRef="Gateway_ApprovalResult" targetRef="Task_ApproveContract" name="Да" />
    <bpmn:sequenceFlow id="Flow_Legal_10" sourceRef="Gateway_ApprovalResult" targetRef="Task_ReviseContract" name="Нет" />
    <bpmn:sequenceFlow id="Flow_Legal_11" sourceRef="Task_ReviseContract" targetRef="Task_ApproveContract" />
    <bpmn:sequenceFlow id="Flow_Legal_12" sourceRef="Task_ApproveContract" targetRef="Event_SendContract" />
    <bpmn:sequenceFlow id="Flow_Legal_13" sourceRef="Event_SendContract" targetRef="Task_SendContractToClient" />
    <bpmn:sequenceFlow id="Flow_Legal_14" sourceRef="Task_SendContractToClient" targetRef="Event_WaitSignature" />
    <bpmn:sequenceFlow id="Flow_Legal_15" sourceRef="Event_WaitSignature" targetRef="EndEvent_Legal" />
  </bpmn:process>

  <!-- Процесс Клиента -->
  <bpmn:process id="Process_Client" name="Процесс клиента" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Client" name="Получение коммерческого предложения">
      <bpmn:outgoing>Flow_Client_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс анализа предложения -->
    <bpmn:subProcess id="SubProcess_ProposalAnalysis" name="Анализ коммерческого предложения">
      <bpmn:incoming>Flow_Client_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_2</bpmn:outgoing>
      
      <bpmn:task id="Task_ReviewProposal" name="Рассмотрение коммерческого предложения">
        <bpmn:incoming>Flow_Client_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_InternalConsultation" name="Внутреннее согласование">
        <bpmn:incoming>Flow_Client_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_BudgetApproval" name="Согласование бюджета">
        <bpmn:incoming>Flow_Client_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Sub_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Client_Sub_1" sourceRef="SubProcess_ProposalAnalysis" targetRef="Task_ReviewProposal" />
      <bpmn:sequenceFlow id="Flow_Client_Sub_2" sourceRef="Task_ReviewProposal" targetRef="Task_InternalConsultation" />
      <bpmn:sequenceFlow id="Flow_Client_Sub_3" sourceRef="Task_InternalConsultation" targetRef="Task_BudgetApproval" />
      <bpmn:sequenceFlow id="Flow_Client_Sub_4" sourceRef="Task_BudgetApproval" targetRef="SubProcess_ProposalAnalysis" />
    </bpmn:subProcess>
    
    <!-- Шлюз для принятия решения -->
    <bpmn:exclusiveGateway id="Gateway_ClientDecision" name="Принимаем предложение?">
      <bpmn:incoming>Flow_Client_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Client_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Промежуточное событие - отклонение -->
    <bpmn:intermediateThrowEvent id="Event_RejectProposal" name="Отклонение предложения">
      <bpmn:incoming>Flow_Client_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_5</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:endEvent id="EndEvent_ClientReject" name="Завершение - отклонение">
      <bpmn:incoming>Flow_Client_5</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_SignContract" name="Подписание договора">
      <bpmn:incoming>Flow_Client_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_6</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - договор подписан -->
    <bpmn:intermediateThrowEvent id="Event_ContractSigned" name="Договор подписан">
      <bpmn:incoming>Flow_Client_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Подпроцесс оплаты -->
    <bpmn:subProcess id="SubProcess_Payment" name="Процесс оплаты">
      <bpmn:incoming>Flow_Client_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_8</bpmn:outgoing>
      
      <bpmn:task id="Task_PreparePayment" name="Подготовка к оплате">
        <bpmn:incoming>Flow_Client_Pay_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Pay_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_MakePayment" name="Оплата услуг">
        <bpmn:incoming>Flow_Client_Pay_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Pay_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_VerifyPayment" name="Проверка оплаты">
        <bpmn:incoming>Flow_Client_Pay_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Client_Pay_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Client_Pay_1" sourceRef="SubProcess_Payment" targetRef="Task_PreparePayment" />
      <bpmn:sequenceFlow id="Flow_Client_Pay_2" sourceRef="Task_PreparePayment" targetRef="Task_MakePayment" />
      <bpmn:sequenceFlow id="Flow_Client_Pay_3" sourceRef="Task_MakePayment" targetRef="Task_VerifyPayment" />
      <bpmn:sequenceFlow id="Flow_Client_Pay_4" sourceRef="Task_VerifyPayment" targetRef="SubProcess_Payment" />
    </bpmn:subProcess>
    
    <!-- Промежуточное событие - оплата завершена -->
    <bpmn:intermediateThrowEvent id="Event_PaymentCompleted" name="Оплата завершена">
      <bpmn:incoming>Flow_Client_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_9</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:endEvent id="EndEvent_Client" name="Завершение взаимодействия с клиентом">
      <bpmn:incoming>Flow_Client_9</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_Client_1" sourceRef="StartEvent_Client" targetRef="SubProcess_ProposalAnalysis" />
    <bpmn:sequenceFlow id="Flow_Client_2" sourceRef="SubProcess_ProposalAnalysis" targetRef="Gateway_ClientDecision" />
    <bpmn:sequenceFlow id="Flow_Client_3" sourceRef="Gateway_ClientDecision" targetRef="Task_SignContract" name="Да" />
    <bpmn:sequenceFlow id="Flow_Client_4" sourceRef="Gateway_ClientDecision" targetRef="Event_RejectProposal" name="Нет" />
    <bpmn:sequenceFlow id="Flow_Client_5" sourceRef="Event_RejectProposal" targetRef="EndEvent_ClientReject" />
    <bpmn:sequenceFlow id="Flow_Client_6" sourceRef="Task_SignContract" targetRef="Event_ContractSigned" />
    <bpmn:sequenceFlow id="Flow_Client_7" sourceRef="Event_ContractSigned" targetRef="SubProcess_Payment" />
    <bpmn:sequenceFlow id="Flow_Client_8" sourceRef="SubProcess_Payment" targetRef="Event_PaymentCompleted" />
    <bpmn:sequenceFlow id="Flow_Client_9" sourceRef="Event_PaymentCompleted" targetRef="EndEvent_Client" />
  </bpmn:process>

  <!-- Процесс Бухгалтерии -->
  <bpmn:process id="Process_Accounting" name="Процесс бухгалтерии" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Accounting" name="Получение подписанного договора">
      <bpmn:outgoing>Flow_Accounting_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс финансового планирования -->
    <bpmn:subProcess id="SubProcess_FinancialPlanning" name="Финансовое планирование">
      <bpmn:incoming>Flow_Accounting_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_2</bpmn:outgoing>
      
      <bpmn:task id="Task_CalculateCosts" name="Расчет стоимости услуг">
        <bpmn:incoming>Flow_Accounting_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CheckBudget" name="Проверка бюджета">
        <bpmn:incoming>Flow_Accounting_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_PlanCashFlow" name="Планирование денежных потоков">
        <bpmn:incoming>Flow_Accounting_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Sub_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Accounting_Sub_1" sourceRef="SubProcess_FinancialPlanning" targetRef="Task_CalculateCosts" />
      <bpmn:sequenceFlow id="Flow_Accounting_Sub_2" sourceRef="Task_CalculateCosts" targetRef="Task_CheckBudget" />
      <bpmn:sequenceFlow id="Flow_Accounting_Sub_3" sourceRef="Task_CheckBudget" targetRef="Task_PlanCashFlow" />
      <bpmn:sequenceFlow id="Flow_Accounting_Sub_4" sourceRef="Task_PlanCashFlow" targetRef="SubProcess_FinancialPlanning" />
    </bpmn:subProcess>
    
    <bpmn:task id="Task_IssueInvoice" name="Выставление счета на оплату">
      <bpmn:incoming>Flow_Accounting_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - счет выставлен -->
    <bpmn:intermediateThrowEvent id="Event_InvoiceIssued" name="Счет выставлен">
      <bpmn:incoming>Flow_Accounting_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Промежуточное событие - ожидание оплаты -->
    <bpmn:intermediateCatchEvent id="Event_WaitPayment" name="Ожидание оплаты">
      <bpmn:incoming>Flow_Accounting_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Подпроцесс обработки платежа -->
    <bpmn:subProcess id="SubProcess_PaymentProcessing" name="Обработка платежа">
      <bpmn:incoming>Flow_Accounting_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_6</bpmn:outgoing>
      
      <bpmn:task id="Task_ProcessPayment" name="Обработка поступления оплаты">
        <bpmn:incoming>Flow_Accounting_Pay_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Pay_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_VerifyPaymentAmount" name="Проверка суммы платежа">
        <bpmn:incoming>Flow_Accounting_Pay_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Pay_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:exclusiveGateway id="Gateway_PaymentVerification" name="Сумма корректна?">
        <bpmn:incoming>Flow_Accounting_Pay_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Pay_4</bpmn:outgoing>
        <bpmn:outgoing>Flow_Accounting_Pay_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      
      <bpmn:task id="Task_ResolvePaymentIssue" name="Решение проблемы с платежом">
        <bpmn:incoming>Flow_Accounting_Pay_5</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Pay_6</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_RecordPayment" name="Запись платежа в учет">
        <bpmn:incoming>Flow_Accounting_Pay_4</bpmn:incoming>
        <bpmn:incoming>Flow_Accounting_Pay_6</bpmn:incoming>
        <bpmn:outgoing>Flow_Accounting_Pay_7</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_1" sourceRef="SubProcess_PaymentProcessing" targetRef="Task_ProcessPayment" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_2" sourceRef="Task_ProcessPayment" targetRef="Task_VerifyPaymentAmount" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_3" sourceRef="Task_VerifyPaymentAmount" targetRef="Gateway_PaymentVerification" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_4" sourceRef="Gateway_PaymentVerification" targetRef="Task_RecordPayment" name="Да" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_5" sourceRef="Gateway_PaymentVerification" targetRef="Task_ResolvePaymentIssue" name="Нет" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_6" sourceRef="Task_ResolvePaymentIssue" targetRef="Task_RecordPayment" />
      <bpmn:sequenceFlow id="Flow_Accounting_Pay_7" sourceRef="Task_RecordPayment" targetRef="SubProcess_PaymentProcessing" />
    </bpmn:subProcess>
    
    <!-- Промежуточное событие - оплата подтверждена -->
    <bpmn:intermediateThrowEvent id="Event_PaymentConfirmed" name="Оплата подтверждена">
      <bpmn:incoming>Flow_Accounting_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:task id="Task_CreateAct" name="Оформление акта оказанных услуг">
      <bpmn:incoming>Flow_Accounting_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_8</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Параллельный шлюз для финальных операций -->
    <bpmn:parallelGateway id="Gateway_FinalOperations" name="Параллельные финальные операции">
      <bpmn:incoming>Flow_Accounting_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accounting_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:task id="Task_CreateReconciliation" name="Акт сверки взаиморасчетов">
      <bpmn:incoming>Flow_Accounting_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_UpdateFinancialReports" name="Обновление финансовой отчетности">
      <bpmn:incoming>Flow_Accounting_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_12</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Соединительный шлюз -->
    <bpmn:parallelGateway id="Gateway_JoinFinal" name="Ожидание завершения всех операций">
      <bpmn:incoming>Flow_Accounting_11</bpmn:incoming>
      <bpmn:incoming>Flow_Accounting_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:endEvent id="EndEvent_Accounting" name="Завершение финансового оформления">
      <bpmn:incoming>Flow_Accounting_13</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_Accounting_1" sourceRef="StartEvent_Accounting" targetRef="SubProcess_FinancialPlanning" />
    <bpmn:sequenceFlow id="Flow_Accounting_2" sourceRef="SubProcess_FinancialPlanning" targetRef="Task_IssueInvoice" />
    <bpmn:sequenceFlow id="Flow_Accounting_3" sourceRef="Task_IssueInvoice" targetRef="Event_InvoiceIssued" />
    <bpmn:sequenceFlow id="Flow_Accounting_4" sourceRef="Event_InvoiceIssued" targetRef="Event_WaitPayment" />
    <bpmn:sequenceFlow id="Flow_Accounting_5" sourceRef="Event_WaitPayment" targetRef="SubProcess_PaymentProcessing" />
    <bpmn:sequenceFlow id="Flow_Accounting_6" sourceRef="SubProcess_PaymentProcessing" targetRef="Event_PaymentConfirmed" />
    <bpmn:sequenceFlow id="Flow_Accounting_7" sourceRef="Event_PaymentConfirmed" targetRef="Task_CreateAct" />
    <bpmn:sequenceFlow id="Flow_Accounting_8" sourceRef="Task_CreateAct" targetRef="Gateway_FinalOperations" />
    <bpmn:sequenceFlow id="Flow_Accounting_9" sourceRef="Gateway_FinalOperations" targetRef="Task_CreateReconciliation" />
    <bpmn:sequenceFlow id="Flow_Accounting_10" sourceRef="Gateway_FinalOperations" targetRef="Task_UpdateFinancialReports" />
    <bpmn:sequenceFlow id="Flow_Accounting_11" sourceRef="Task_CreateReconciliation" targetRef="Gateway_JoinFinal" />
    <bpmn:sequenceFlow id="Flow_Accounting_12" sourceRef="Task_UpdateFinancialReports" targetRef="Gateway_JoinFinal" />
    <bpmn:sequenceFlow id="Flow_Accounting_13" sourceRef="Gateway_JoinFinal" targetRef="EndEvent_Accounting" />
  </bpmn:process>

  <!-- Процесс Учебного отдела -->
  <bpmn:process id="Process_Education" name="Процесс учебного отдела" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Education" name="Получение оплаченного договора">
      <bpmn:outgoing>Flow_Education_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс планирования обучения -->
    <bpmn:subProcess id="SubProcess_TrainingPlanning" name="Планирование обучения">
      <bpmn:incoming>Flow_Education_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_2</bpmn:outgoing>
      
      <bpmn:task id="Task_AnalyzeRequirements" name="Анализ требований клиента">
        <bpmn:incoming>Flow_Education_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_DesignCurriculum" name="Разработка учебной программы">
        <bpmn:incoming>Flow_Education_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_SelectMaterials" name="Подбор учебных материалов">
        <bpmn:incoming>Flow_Education_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Sub_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Education_Sub_1" sourceRef="SubProcess_TrainingPlanning" targetRef="Task_AnalyzeRequirements" />
      <bpmn:sequenceFlow id="Flow_Education_Sub_2" sourceRef="Task_AnalyzeRequirements" targetRef="Task_DesignCurriculum" />
      <bpmn:sequenceFlow id="Flow_Education_Sub_3" sourceRef="Task_DesignCurriculum" targetRef="Task_SelectMaterials" />
      <bpmn:sequenceFlow id="Flow_Education_Sub_4" sourceRef="Task_SelectMaterials" targetRef="SubProcess_TrainingPlanning" />
    </bpmn:subProcess>
    
    <bpmn:task id="Task_CreateStudyProgram" name="Создание учебной программы">
      <bpmn:incoming>Flow_Education_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Шлюз для проверки готовности программы -->
    <bpmn:exclusiveGateway id="Gateway_ProgramReady" name="Программа готова?">
      <bpmn:incoming>Flow_Education_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Education_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ReviseProgram" name="Доработка программы">
      <bpmn:incoming>Flow_Education_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ApproveProgram" name="Утверждение программы">
      <bpmn:incoming>Flow_Education_4</bpmn:incoming>
      <bpmn:incoming>Flow_Education_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_7</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - программа утверждена -->
    <bpmn:intermediateThrowEvent id="Event_ProgramApproved" name="Программа утверждена">
      <bpmn:incoming>Flow_Education_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_8</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Подпроцесс проведения обучения -->
    <bpmn:subProcess id="SubProcess_TrainingDelivery" name="Проведение обучения">
      <bpmn:incoming>Flow_Education_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_9</bpmn:outgoing>
      
      <bpmn:task id="Task_PrepareTraining" name="Подготовка к обучению">
        <bpmn:incoming>Flow_Education_Del_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Del_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_ConductTraining" name="Проведение обучения">
        <bpmn:incoming>Flow_Education_Del_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Del_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_MonitorProgress" name="Контроль прогресса">
        <bpmn:incoming>Flow_Education_Del_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Del_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CollectFeedback" name="Сбор обратной связи">
        <bpmn:incoming>Flow_Education_Del_4</bpmn:incoming>
        <bpmn:outgoing>Flow_Education_Del_5</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Education_Del_1" sourceRef="SubProcess_TrainingDelivery" targetRef="Task_PrepareTraining" />
      <bpmn:sequenceFlow id="Flow_Education_Del_2" sourceRef="Task_PrepareTraining" targetRef="Task_ConductTraining" />
      <bpmn:sequenceFlow id="Flow_Education_Del_3" sourceRef="Task_ConductTraining" targetRef="Task_MonitorProgress" />
      <bpmn:sequenceFlow id="Flow_Education_Del_4" sourceRef="Task_MonitorProgress" targetRef="Task_CollectFeedback" />
      <bpmn:sequenceFlow id="Flow_Education_Del_5" sourceRef="Task_CollectFeedback" targetRef="SubProcess_TrainingDelivery" />
    </bpmn:subProcess>
    
    <!-- Промежуточное событие - обучение завершено -->
    <bpmn:intermediateThrowEvent id="Event_TrainingCompleted" name="Обучение завершено">
      <bpmn:incoming>Flow_Education_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_10</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Параллельный шлюз для финальных операций -->
    <bpmn:parallelGateway id="Gateway_FinalEducation" name="Параллельные финальные операции">
      <bpmn:incoming>Flow_Education_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_Education_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:task id="Task_CreateCertificates" name="Выдача сертификатов">
      <bpmn:incoming>Flow_Education_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_13</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_PrepareReport" name="Подготовка отчета о результатах">
      <bpmn:incoming>Flow_Education_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_14</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Соединительный шлюз -->
    <bpmn:parallelGateway id="Gateway_JoinEducation" name="Ожидание завершения всех операций">
      <bpmn:incoming>Flow_Education_13</bpmn:incoming>
      <bpmn:incoming>Flow_Education_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Education_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:endEvent id="EndEvent_Education" name="Завершение образовательного процесса">
      <bpmn:incoming>Flow_Education_15</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_Education_1" sourceRef="StartEvent_Education" targetRef="SubProcess_TrainingPlanning" />
    <bpmn:sequenceFlow id="Flow_Education_2" sourceRef="SubProcess_TrainingPlanning" targetRef="Task_CreateStudyProgram" />
    <bpmn:sequenceFlow id="Flow_Education_3" sourceRef="Task_CreateStudyProgram" targetRef="Gateway_ProgramReady" />
    <bpmn:sequenceFlow id="Flow_Education_4" sourceRef="Gateway_ProgramReady" targetRef="Task_ApproveProgram" name="Да" />
    <bpmn:sequenceFlow id="Flow_Education_5" sourceRef="Gateway_ProgramReady" targetRef="Task_ReviseProgram" name="Нет" />
    <bpmn:sequenceFlow id="Flow_Education_6" sourceRef="Task_ReviseProgram" targetRef="Task_ApproveProgram" />
    <bpmn:sequenceFlow id="Flow_Education_7" sourceRef="Task_ApproveProgram" targetRef="Event_ProgramApproved" />
    <bpmn:sequenceFlow id="Flow_Education_8" sourceRef="Event_ProgramApproved" targetRef="SubProcess_TrainingDelivery" />
    <bpmn:sequenceFlow id="Flow_Education_9" sourceRef="SubProcess_TrainingDelivery" targetRef="Event_TrainingCompleted" />
    <bpmn:sequenceFlow id="Flow_Education_10" sourceRef="Event_TrainingCompleted" targetRef="Gateway_FinalEducation" />
    <bpmn:sequenceFlow id="Flow_Education_11" sourceRef="Gateway_FinalEducation" targetRef="Task_CreateCertificates" />
    <bpmn:sequenceFlow id="Flow_Education_12" sourceRef="Gateway_FinalEducation" targetRef="Task_PrepareReport" />
    <bpmn:sequenceFlow id="Flow_Education_13" sourceRef="Task_CreateCertificates" targetRef="Gateway_JoinEducation" />
    <bpmn:sequenceFlow id="Flow_Education_14" sourceRef="Task_PrepareReport" targetRef="Gateway_JoinEducation" />
    <bpmn:sequenceFlow id="Flow_Education_15" sourceRef="Gateway_JoinEducation" targetRef="EndEvent_Education" />
  </bpmn:process>

  <!-- Процесс Кадрового отдела -->
  <bpmn:process id="Process_HR" name="Процесс кадрового отдела" isExecutable="true">
    <bpmn:startEvent id="StartEvent_HR" name="Получение запроса на преподавателей">
      <bpmn:outgoing>Flow_HR_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс подбора преподавателей -->
    <bpmn:subProcess id="SubProcess_TeacherSelection" name="Подбор преподавателей">
      <bpmn:incoming>Flow_HR_1</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_2</bpmn:outgoing>
      
      <bpmn:task id="Task_AnalyzeTeacherRequirements" name="Анализ требований к преподавателям">
        <bpmn:incoming>Flow_HR_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_SearchTeachers" name="Поиск подходящих преподавателей">
        <bpmn:incoming>Flow_HR_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_InterviewTeachers" name="Интервью с кандидатами">
        <bpmn:incoming>Flow_HR_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:exclusiveGateway id="Gateway_TeacherSelection" name="Кандидаты найдены?">
        <bpmn:incoming>Flow_HR_Sub_4</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_5</bpmn:outgoing>
        <bpmn:outgoing>Flow_HR_Sub_6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      
      <bpmn:task id="Task_SelectTeachers" name="Отбор преподавателей">
        <bpmn:incoming>Flow_HR_Sub_5</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_7</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_ExpandSearch" name="Расширение поиска">
        <bpmn:incoming>Flow_HR_Sub_6</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Sub_8</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_HR_Sub_1" sourceRef="SubProcess_TeacherSelection" targetRef="Task_AnalyzeTeacherRequirements" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_2" sourceRef="Task_AnalyzeTeacherRequirements" targetRef="Task_SearchTeachers" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_3" sourceRef="Task_SearchTeachers" targetRef="Task_InterviewTeachers" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_4" sourceRef="Task_InterviewTeachers" targetRef="Gateway_TeacherSelection" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_5" sourceRef="Gateway_TeacherSelection" targetRef="Task_SelectTeachers" name="Да" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_6" sourceRef="Gateway_TeacherSelection" targetRef="Task_ExpandSearch" name="Нет" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_7" sourceRef="Task_SelectTeachers" targetRef="SubProcess_TeacherSelection" />
      <bpmn:sequenceFlow id="Flow_HR_Sub_8" sourceRef="Task_ExpandSearch" targetRef="Task_SearchTeachers" />
    </bpmn:subProcess>
    
    <bpmn:task id="Task_AssignTeachers" name="Оформление преподавателей">
      <bpmn:incoming>Flow_HR_2</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - преподаватели назначены -->
    <bpmn:intermediateThrowEvent id="Event_TeachersAssigned" name="Преподаватели назначены">
      <bpmn:incoming>Flow_HR_3</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Подпроцесс управления персоналом -->
    <bpmn:subProcess id="SubProcess_PersonnelManagement" name="Управление персоналом">
      <bpmn:incoming>Flow_HR_4</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_5</bpmn:outgoing>
      
      <bpmn:task id="Task_ManageWorkTime" name="Учет рабочего времени">
        <bpmn:incoming>Flow_HR_Mgmt_1</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Mgmt_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_MonitorPerformance" name="Контроль эффективности">
        <bpmn:incoming>Flow_HR_Mgmt_2</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Mgmt_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_HandleIssues" name="Решение проблем персонала">
        <bpmn:incoming>Flow_HR_Mgmt_3</bpmn:incoming>
        <bpmn:outgoing>Flow_HR_Mgmt_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_HR_Mgmt_1" sourceRef="SubProcess_PersonnelManagement" targetRef="Task_ManageWorkTime" />
      <bpmn:sequenceFlow id="Flow_HR_Mgmt_2" sourceRef="Task_ManageWorkTime" targetRef="Task_MonitorPerformance" />
      <bpmn:sequenceFlow id="Flow_HR_Mgmt_3" sourceRef="Task_MonitorPerformance" targetRef="Task_HandleIssues" />
      <bpmn:sequenceFlow id="Flow_HR_Mgmt_4" sourceRef="Task_HandleIssues" targetRef="SubProcess_PersonnelManagement" />
    </bpmn:subProcess>
    
    <!-- Промежуточное событие - управление завершено -->
    <bpmn:intermediateThrowEvent id="Event_ManagementCompleted" name="Управление завершено">
      <bpmn:incoming>Flow_HR_5</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_6</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:endEvent id="EndEvent_HR" name="Завершение кадрового сопровождения">
      <bpmn:incoming>Flow_HR_6</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_HR_1" sourceRef="StartEvent_HR" targetRef="SubProcess_TeacherSelection" />
    <bpmn:sequenceFlow id="Flow_HR_2" sourceRef="SubProcess_TeacherSelection" targetRef="Task_AssignTeachers" />
    <bpmn:sequenceFlow id="Flow_HR_3" sourceRef="Task_AssignTeachers" targetRef="Event_TeachersAssigned" />
    <bpmn:sequenceFlow id="Flow_HR_4" sourceRef="Event_TeachersAssigned" targetRef="SubProcess_PersonnelManagement" />
    <bpmn:sequenceFlow id="Flow_HR_5" sourceRef="SubProcess_PersonnelManagement" targetRef="Event_ManagementCompleted" />
    <bpmn:sequenceFlow id="Flow_HR_6" sourceRef="Event_ManagementCompleted" targetRef="EndEvent_HR" />
  </bpmn:process>

  <!-- Процесс Руководства/Администрации -->
  <bpmn:process id="Process_Management" name="Процесс руководства" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Management" name="Получение документов на утверждение">
      <bpmn:outgoing>Flow_Management_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс анализа документов -->
    <bpmn:subProcess id="SubProcess_DocumentAnalysis" name="Анализ документов">
      <bpmn:incoming>Flow_Management_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_2</bpmn:outgoing>
      
      <bpmn:task id="Task_ReviewDocument" name="Рассмотрение документа">
        <bpmn:incoming>Flow_Management_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Management_Sub_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_AssessRisk" name="Оценка рисков">
        <bpmn:incoming>Flow_Management_Sub_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Management_Sub_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CheckCompliance" name="Проверка соответствия политикам">
        <bpmn:incoming>Flow_Management_Sub_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Management_Sub_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Management_Sub_1" sourceRef="SubProcess_DocumentAnalysis" targetRef="Task_ReviewDocument" />
      <bpmn:sequenceFlow id="Flow_Management_Sub_2" sourceRef="Task_ReviewDocument" targetRef="Task_AssessRisk" />
      <bpmn:sequenceFlow id="Flow_Management_Sub_3" sourceRef="Task_AssessRisk" targetRef="Task_CheckCompliance" />
      <bpmn:sequenceFlow id="Flow_Management_Sub_4" sourceRef="Task_CheckCompliance" targetRef="SubProcess_DocumentAnalysis" />
    </bpmn:subProcess>
    
    <!-- Шлюз для принятия решения -->
    <bpmn:exclusiveGateway id="Gateway_ManagementDecision" name="Документ утверждается?">
      <bpmn:incoming>Flow_Management_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Management_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ApproveDocuments" name="Утверждение регламентов и документов">
      <bpmn:incoming>Flow_Management_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_RejectDocument" name="Отклонение документа">
      <bpmn:incoming>Flow_Management_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_6</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - документ утвержден -->
    <bpmn:intermediateThrowEvent id="Event_DocumentApproved" name="Документ утвержден">
      <bpmn:incoming>Flow_Management_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Промежуточное событие - документ отклонен -->
    <bpmn:intermediateThrowEvent id="Event_DocumentRejected" name="Документ отклонен">
      <bpmn:incoming>Flow_Management_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_8</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:task id="Task_ControlProcess" name="Контроль процессов">
      <bpmn:incoming>Flow_Management_7</bpmn:incoming>
      <bpmn:incoming>Flow_Management_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Management_9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_Management" name="Завершение административного контроля">
      <bpmn:incoming>Flow_Management_9</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_Management_1" sourceRef="StartEvent_Management" targetRef="SubProcess_DocumentAnalysis" />
    <bpmn:sequenceFlow id="Flow_Management_2" sourceRef="SubProcess_DocumentAnalysis" targetRef="Gateway_ManagementDecision" />
    <bpmn:sequenceFlow id="Flow_Management_3" sourceRef="Gateway_ManagementDecision" targetRef="Task_ApproveDocuments" name="Да" />
    <bpmn:sequenceFlow id="Flow_Management_4" sourceRef="Gateway_ManagementDecision" targetRef="Task_RejectDocument" name="Нет" />
    <bpmn:sequenceFlow id="Flow_Management_5" sourceRef="Task_ApproveDocuments" targetRef="Event_DocumentApproved" />
    <bpmn:sequenceFlow id="Flow_Management_6" sourceRef="Task_RejectDocument" targetRef="Event_DocumentRejected" />
    <bpmn:sequenceFlow id="Flow_Management_7" sourceRef="Event_DocumentApproved" targetRef="Task_ControlProcess" />
    <bpmn:sequenceFlow id="Flow_Management_8" sourceRef="Event_DocumentRejected" targetRef="Task_ControlProcess" />
    <bpmn:sequenceFlow id="Flow_Management_9" sourceRef="Task_ControlProcess" targetRef="EndEvent_Management" />
  </bpmn:process>

  <!-- Процесс Базы данных документооборота -->
  <bpmn:process id="Process_Database" name="Процесс базы данных документооборота" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Database" name="Получение документа для регистрации">
      <bpmn:outgoing>Flow_Database_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Подпроцесс валидации документа -->
    <bpmn:subProcess id="SubProcess_DocumentValidation" name="Валидация документа">
      <bpmn:incoming>Flow_Database_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_2</bpmn:outgoing>
      
      <bpmn:task id="Task_ValidateFormat" name="Проверка формата документа">
        <bpmn:incoming>Flow_Database_Val_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Val_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CheckCompleteness" name="Проверка полноты данных">
        <bpmn:incoming>Flow_Database_Val_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Val_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_VerifyIntegrity" name="Проверка целостности">
        <bpmn:incoming>Flow_Database_Val_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Val_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Database_Val_1" sourceRef="SubProcess_DocumentValidation" targetRef="Task_ValidateFormat" />
      <bpmn:sequenceFlow id="Flow_Database_Val_2" sourceRef="Task_ValidateFormat" targetRef="Task_CheckCompleteness" />
      <bpmn:sequenceFlow id="Flow_Database_Val_3" sourceRef="Task_CheckCompleteness" targetRef="Task_VerifyIntegrity" />
      <bpmn:sequenceFlow id="Flow_Database_Val_4" sourceRef="Task_VerifyIntegrity" targetRef="SubProcess_DocumentValidation" />
    </bpmn:subProcess>
    
    <!-- Шлюз для определения типа документа -->
    <bpmn:exclusiveGateway id="Gateway_DocumentType" name="Определение типа документа">
      <bpmn:incoming>Flow_Database_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_Contract</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_Financial</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_Education</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_HR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Параллельный шлюз для обработки документов -->
    <bpmn:parallelGateway id="Gateway_ParallelProcessing" name="Параллельная обработка">
      <bpmn:incoming>Flow_Database_Contract</bpmn:incoming>
      <bpmn:incoming>Flow_Database_Financial</bpmn:incoming>
      <bpmn:incoming>Flow_Database_Education</bpmn:incoming>
      <bpmn:incoming>Flow_Database_HR</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_Contract_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_Financial_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_Education_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Database_HR_Process</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Обработка договорных документов -->
    <bpmn:task id="Task_RegisterContract" name="Регистрация договорных документов">
      <bpmn:incoming>Flow_Database_Contract_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_Contract_Update</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Обработка финансовых документов -->
    <bpmn:task id="Task_RegisterFinancial" name="Регистрация финансовых документов">
      <bpmn:incoming>Flow_Database_Financial_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_Financial_Update</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Обработка учебных документов -->
    <bpmn:task id="Task_RegisterEducation" name="Регистрация учебных документов">
      <bpmn:incoming>Flow_Database_Education_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_Education_Update</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Обработка кадровых документов -->
    <bpmn:task id="Task_RegisterHR" name="Регистрация кадровых документов">
      <bpmn:incoming>Flow_Database_HR_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_HR_Update</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Соединительный шлюз -->
    <bpmn:parallelGateway id="Gateway_JoinProcessing" name="Ожидание завершения обработки">
      <bpmn:incoming>Flow_Database_Contract_Update</bpmn:incoming>
      <bpmn:incoming>Flow_Database_Financial_Update</bpmn:incoming>
      <bpmn:incoming>Flow_Database_Education_Update</bpmn:incoming>
      <bpmn:incoming>Flow_Database_HR_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Обновление статусов -->
    <bpmn:task id="Task_UpdateStatus" name="Обновление статуса документа">
      <bpmn:incoming>Flow_Database_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_4</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Промежуточное событие - статус обновлен -->
    <bpmn:intermediateThrowEvent id="Event_StatusUpdated" name="Статус обновлен">
      <bpmn:incoming>Flow_Database_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_5</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <!-- Подпроцесс архивирования -->
    <bpmn:subProcess id="SubProcess_Archiving" name="Архивирование документа">
      <bpmn:incoming>Flow_Database_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_6</bpmn:outgoing>
      
      <bpmn:task id="Task_ArchiveDocument" name="Архивирование документа">
        <bpmn:incoming>Flow_Database_Arch_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Arch_2</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_CreateIndex" name="Создание индекса">
        <bpmn:incoming>Flow_Database_Arch_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Arch_3</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:task id="Task_UpdateMetadata" name="Обновление метаданных">
        <bpmn:incoming>Flow_Database_Arch_3</bpmn:incoming>
        <bpmn:outgoing>Flow_Database_Arch_4</bpmn:outgoing>
      </bpmn:task>
      
      <bpmn:sequenceFlow id="Flow_Database_Arch_1" sourceRef="SubProcess_Archiving" targetRef="Task_ArchiveDocument" />
      <bpmn:sequenceFlow id="Flow_Database_Arch_2" sourceRef="Task_ArchiveDocument" targetRef="Task_CreateIndex" />
      <bpmn:sequenceFlow id="Flow_Database_Arch_3" sourceRef="Task_CreateIndex" targetRef="Task_UpdateMetadata" />
      <bpmn:sequenceFlow id="Flow_Database_Arch_4" sourceRef="Task_UpdateMetadata" targetRef="SubProcess_Archiving" />
    </bpmn:subProcess>
    
    <!-- Промежуточное событие - документ заархивирован -->
    <bpmn:intermediateThrowEvent id="Event_DocumentArchived" name="Документ заархивирован">
      <bpmn:incoming>Flow_Database_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Database_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    
    <bpmn:endEvent id="EndEvent_Database" name="Завершение обработки документа">
      <bpmn:incoming>Flow_Database_7</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Потоки для процесса БД -->
    <bpmn:sequenceFlow id="Flow_Database_1" sourceRef="StartEvent_Database" targetRef="SubProcess_DocumentValidation" />
    <bpmn:sequenceFlow id="Flow_Database_2" sourceRef="SubProcess_DocumentValidation" targetRef="Gateway_DocumentType" />
    <bpmn:sequenceFlow id="Flow_Database_Contract" sourceRef="Gateway_DocumentType" targetRef="Gateway_ParallelProcessing" name="Договорные документы" />
    <bpmn:sequenceFlow id="Flow_Database_Financial" sourceRef="Gateway_DocumentType" targetRef="Gateway_ParallelProcessing" name="Финансовые документы" />
    <bpmn:sequenceFlow id="Flow_Database_Education" sourceRef="Gateway_DocumentType" targetRef="Gateway_ParallelProcessing" name="Учебные документы" />
    <bpmn:sequenceFlow id="Flow_Database_HR" sourceRef="Gateway_DocumentType" targetRef="Gateway_ParallelProcessing" name="Кадровые документы" />
    <bpmn:sequenceFlow id="Flow_Database_Contract_Process" sourceRef="Gateway_ParallelProcessing" targetRef="Task_RegisterContract" />
    <bpmn:sequenceFlow id="Flow_Database_Financial_Process" sourceRef="Gateway_ParallelProcessing" targetRef="Task_RegisterFinancial" />
    <bpmn:sequenceFlow id="Flow_Database_Education_Process" sourceRef="Gateway_ParallelProcessing" targetRef="Task_RegisterEducation" />
    <bpmn:sequenceFlow id="Flow_Database_HR_Process" sourceRef="Gateway_ParallelProcessing" targetRef="Task_RegisterHR" />
    <bpmn:sequenceFlow id="Flow_Database_Contract_Update" sourceRef="Task_RegisterContract" targetRef="Gateway_JoinProcessing" />
    <bpmn:sequenceFlow id="Flow_Database_Financial_Update" sourceRef="Task_RegisterFinancial" targetRef="Gateway_JoinProcessing" />
    <bpmn:sequenceFlow id="Flow_Database_Education_Update" sourceRef="Task_RegisterEducation" targetRef="Gateway_JoinProcessing" />
    <bpmn:sequenceFlow id="Flow_Database_HR_Update" sourceRef="Task_RegisterHR" targetRef="Gateway_JoinProcessing" />
    <bpmn:sequenceFlow id="Flow_Database_3" sourceRef="Gateway_JoinProcessing" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_Database_4" sourceRef="Task_UpdateStatus" targetRef="Event_StatusUpdated" />
    <bpmn:sequenceFlow id="Flow_Database_5" sourceRef="Event_StatusUpdated" targetRef="SubProcess_Archiving" />
    <bpmn:sequenceFlow id="Flow_Database_6" sourceRef="SubProcess_Archiving" targetRef="Event_DocumentArchived" />
    <bpmn:sequenceFlow id="Flow_Database_7" sourceRef="Event_DocumentArchived" targetRef="EndEvent_Database" />
  </bpmn:process>

  <!-- Диаграмма -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <!-- Участники (пулы) -->
      <bpmndi:BPMNShape id="Participant_Menager_di" bpmnElement="Participant_Menager" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Legal_di" bpmnElement="Participant_Legal" isHorizontal="true">
        <dc:Bounds x="100" y="320" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Client_di" bpmnElement="Participant_Client" isHorizontal="true">
        <dc:Bounds x="100" y="540" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Accounting_di" bpmnElement="Participant_Accounting" isHorizontal="true">
        <dc:Bounds x="100" y="760" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Education_di" bpmnElement="Participant_Education" isHorizontal="true">
        <dc:Bounds x="100" y="980" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_HR_di" bpmnElement="Participant_HR" isHorizontal="true">
        <dc:Bounds x="100" y="1200" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Management_di" bpmnElement="Participant_Management" isHorizontal="true">
        <dc:Bounds x="100" y="1420" width="800" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Database_di" bpmnElement="Participant_Database" isHorizontal="true">
        <dc:Bounds x="100" y="1640" width="800" height="200" />
      </bpmndi:BPMNShape>

      <!-- Элементы процесса менеджера -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="200" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <!-- Подпроцесс обработки заявки -->
      <bpmndi:BPMNShape id="SubProcess_RequestProcessing_di" bpmnElement="SubProcess_RequestProcessing">
        <dc:Bounds x="280" y="130" width="200" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_PrepareCommercialProposal_di" bpmnElement="Task_PrepareCommercialProposal">
        <dc:Bounds x="520" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Промежуточное событие - отправка КП -->
      <bpmndi:BPMNShape id="Event_SendProposal_di" bpmnElement="Event_SendProposal">
        <dc:Bounds x="660" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ApproveConditions_di" bpmnElement="Task_ApproveConditions">
        <dc:Bounds x="740" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Шлюз для проверки согласования -->
      <bpmndi:BPMNShape id="Gateway_Approval_di" bpmnElement="Gateway_Approval">
        <dc:Bounds x="880" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_ReviseProposal_di" bpmnElement="Task_ReviseProposal">
        <dc:Bounds x="980" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_TransferToLegal_di" bpmnElement="Task_TransferToLegal">
        <dc:Bounds x="1120" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Промежуточное событие - ожидание ответа -->
      <bpmndi:BPMNShape id="Event_WaitLegalResponse_di" bpmnElement="Event_WaitLegalResponse">
        <dc:Bounds x="1260" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Menager_di" bpmnElement="EndEvent_Menager">
