{
    "model": "myapp.document",
    "pk": 120,
    "fields": {
        "name": "Запросы",
        "type": "Договор",
        "status": "review",
        "created": "2025-04-10",
        "file": "documents/5_запросов_на_выборку_данных.docx",
        "file_type": "docx",
        "content": "<p><strong>Запрос с LIKE:</strong></p><p>SELECT * FROM \"Организация\"</p><p>WHERE \"Наименование организации\" LIKE '%университет%';</p><p><strong>Запрос с COUNT:</strong></p><p>SELECT COUNT(\"idЛичная карточка\") AS \"Количество карточек\"</p><p>FROM \"Личная карточка работника\";</p><p><strong>Запрос с SUM:</strong></p><p>SELECT SUM(\"Код ОКПО\") AS \"Сумма кодов ОКПО\"</p><p>FROM \"Организация\";</p><p><strong>Запрос с EXPLAIN:</strong></p><p>EXPLAIN SELECT * FROM \"Общие сведения\";</p><p><strong>Запрос с INNER JOIN:</strong></p><p>SELECT *</p><p>FROM \"Общие сведения\"</p><p>INNER JOIN \"Место рождения\"</p><p>ON \"Общие сведения\".\"Место рождения_idМесто рождения\" = \"Место рождения\".\"idМесто рождения\";</p><p><br>like<br>count<br>sum<br>explayn<br>&nbsp;</p>",
        "user": [
            "Александр1"
        ]
    }
},
